{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "sk-YOUR_SECRET",
    "ANTHROPIC_BASE_URL": "https://api.tangguo.xin",
    "HTTP_PROXY": "http://127.0.0.1:7892",
    "HTTPS_PROXY": "http://127.0.0.1:7892",
    "ALL_PROXY": "http://127.0.0.1:7892",
    "NO_PROXY": "127.0.0.1,localhost,::1,*.local,10.*,192.168.*,172.16.*,172.17.*,172.18.*,172.19.*,172.30.*,172.31.*",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "PYTHONUTF8": "1",
    "PYTHONIOENCODING": "utf-8"
  },
  "disableAllHooks": true,
  "theme": "light"
}
