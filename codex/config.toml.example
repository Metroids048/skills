model = "gpt-5.6-terra"
model_reasoning_effort = "high"
http_proxy = "http://127.0.0.1:7892"

service_tier = "default"
notify = [ "C:\\Users\\Windows11\\AppData\\Local\\OpenAI\\Codex\\runtimes\\cua_node\\b474a88d5d105afa\\bin\\node_modules\\@oai\\sky\\bin\\windows\\codex-computer-use.exe", "turn-ended" ]
[projects.'%USERPROFILE%\desktop\number signals']
trust_level = "trusted"

[projects.'%USERPROFILE%\desktop\alpha']
trust_level = "trusted"

[projects.'%USERPROFILE%\desktop\demo']
trust_level = "trusted"

[projects.'%USERPROFILE%\desktop\量化项目']
trust_level = "trusted"

[projects.'%USERPROFILE%\desktop\pm']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\codex\2026-08-09\codex-plugin-windows-api-skill-windows']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\codex\2026-08-19\windows-ai-agent-runtime-codex-claude']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\codex\2026-08-29\zhe']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\codex\2026-08-29\wo']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\codex\2026-08-30\wo-x']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\codex\2026-08-30\ji-xu']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\codex\2026-08-30\qzone-photo-recovery']
trust_level = "trusted"

[projects.'%USERPROFILE%\documents\chatgpt\video1']
trust_level = "trusted"

[projects.'%USERPROFILE%\desktop\ai bug bounty researcher']
trust_level = "trusted"

[projects.'%USERPROFILE%\desktop\全局配置']
trust_level = "trusted"

[marketplaces.openai-bundled]
source_type = "local"
source = '\\?\%USERPROFILE%\.codex\.tmp\bundled-marketplaces\openai-bundled'

[marketplaces.openai-curated]
source_type = "local"
source = '\\?\%USERPROFILE%\.codex\.tmp\plugins'

[marketplaces.openai-api-curated]
source_type = "local"
source = '\\?\%USERPROFILE%\.codex\.tmp\plugins'

[marketplaces.openai-primary-runtime]
source_type = "local"
source = '\\?\%USERPROFILE%\.cache\codex-runtimes\codex-primary-runtime\plugins\openai-primary-runtime'

[features]
js_repl = false

[windows]
sandbox = "elevated"

[plugins."vercel@openai-curated"]
enabled = true

[plugins."canva@openai-curated"]
enabled = true

[plugins."github@openai-curated"]
enabled = true

[plugins."chrome@openai-bundled"]
enabled = true

[plugins."superpowers@openai-curated"]
enabled = true

[plugins."browser@openai-bundled"]
enabled = true

[plugins."visualize@openai-bundled"]
enabled = true

[plugins."sites@openai-bundled"]
enabled = true

[plugins."build-web-apps@openai-curated"]
enabled = true

[plugins."codex-app-tools@openai-bundled"]
enabled = true

[plugins."documents@openai-primary-runtime"]
enabled = true

[plugins."pdf@openai-primary-runtime"]
enabled = true

[plugins."spreadsheets@openai-primary-runtime"]
enabled = true

[plugins."presentations@openai-primary-runtime"]
enabled = true

[plugins."template-creator@openai-primary-runtime"]
enabled = true

[plugins."unified-computer-use@openai-bundled"]
enabled = true

[plugins."computer-use@openai-bundled"]
enabled = true

[desktop]
followUpQueueMode = "queue"

[shell_environment_policy.set]

[mcp_servers]

[mcp_servers.node_repl]
args = []
command = '%USERPROFILE%\AppData\Local\OpenAI\Codex\runtimes\cua_node\b474a88d5d105afa\bin\node_repl.exe'
startup_timeout_sec = 120

[mcp_servers.node_repl.env]
NODE_REPL_NATIVE_PIPE_CONNECT_TIMEOUT_MS = "1000"
NODE_REPL_NODE_MODULE_DIRS = '%USERPROFILE%\AppData\Local\OpenAI\Codex\runtimes\cua_node\b474a88d5d105afa\bin\node_modules'
NODE_REPL_NODE_PATH = '%USERPROFILE%\AppData\Local\OpenAI\Codex\runtimes\cua_node\b474a88d5d105afa\bin\node.exe'
NODE_REPL_TRUSTED_CODE_PATHS = '%USERPROFILE%\.codex;%USERPROFILE%\AppData\Local\OpenAI\Codex\runtimes\cua_node\b474a88d5d105afa\bin\node_modules'
CODEX_HOME = '%USERPROFILE%\.codex'
BROWSER_USE_AVAILABLE_BACKENDS = "chrome,iab"
BROWSER_USE_TINYSKY_ENABLED = "1"
NODE_REPL_INSTRUCTIONS_USE_CASE_BROWSER = ""
NODE_REPL_INSTRUCTIONS_USE_CASE_CHROME = ""
BROWSER_USE_CODEX_APP_BUILD_FLAVOR = "prod"
BROWSER_USE_CODEX_APP_VERSION = "26.901.51231"
SKY_CUA_NATIVE_PIPE = "1"
