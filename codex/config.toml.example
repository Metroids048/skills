model_provider = "custom"
model = "gpt-5.5"
model_reasoning_effort = "high"
disable_response_storage = true

[model_providers.custom]
name = "One-API"
base_url = "http://127.0.0.1:15721/v1"
wire_api = "responses"
requires_openai_auth = true
experimental_bearer_token = "PROXY_MANAGED"

# Core MCP servers for coding / PM / vibe workflows.
# Secrets are not stored here. Set Windows user environment variables as needed:
# GITHUB_PERSONAL_ACCESS_TOKEN, EXA_API_KEY, FAL_KEY, FIGMA_API_KEY.
[projects.'c:\users\win\desktop\agent platform']
trust_level = "trusted"

[projects.'c:\users\win\desktop\敖钦储能项目']
trust_level = "trusted"

[projects.'c:\users\win\desktop\海小南']
trust_level = "trusted"

[projects.'c:\users\win\desktop\ai--main']
trust_level = "trusted"

[projects.'c:\users\win\documents\codex\2026-07-06\wo']
trust_level = "trusted"

[projects.'c:\users\win\documents\codex\2026-07-06\1-3-skills-skills-2-3']
trust_level = "trusted"

[windows]
sandbox = "unelevated"
shell_path = "C:\\Program Files\\PowerShell\\7\\pwsh.exe"

[mcp_servers.github]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-github"]
startup_timeout_sec = 30

[mcp_servers.context7]
command = "npx"
args = ["-y", "@upstash/context7-mcp@latest"]
startup_timeout_sec = 30

[mcp_servers.openaiDeveloperDocs]
url = "https://developers.openai.com/mcp"
startup_timeout_sec = 30

[mcp_servers.memory]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-memory"]
startup_timeout_sec = 30

[mcp_servers.sequential-thinking]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-sequential-thinking"]
startup_timeout_sec = 30

[mcp_servers.playwright]
command = "npx"
args = ["-y", "@playwright/mcp@latest", "--browser", "chrome"]
startup_timeout_sec = 30

[mcp_servers.exa]
command = "npx"
args = ["-y", "mcp-remote", "https://mcp.exa.ai/mcp"]
startup_timeout_sec = 30

[mcp_servers.fal-ai]
command = "npx"
args = ["-y", "fal-ai-mcp-server"]
startup_timeout_sec = 30

[mcp_servers.filesystem-agent-platform]
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem", "C:\\Users\\win\\Desktop\\Agent Platform"]
startup_timeout_sec = 30

[mcp_servers.chrome-devtools]
command = "npx"
args = ["-y", "chrome-devtools-mcp@latest"]
startup_timeout_sec = 30

[mcp_servers.figma]
url = "https://mcp.figma.com/mcp"
startup_timeout_sec = 30

[mcp_servers.figma-desktop]
url = "http://127.0.0.1:3845/mcp"
startup_timeout_sec = 30

[marketplaces.openai-bundled]
last_updated = "2026-06-08T00:00:00Z"
source_type = "local"
source = 'C:\Users\win\.codex\.tmp\bundled-marketplaces\openai-bundled'

[marketplaces.openai-curated]
last_updated = "2026-06-08T00:00:00Z"
source_type = "local"
source = '\\?\C:\Users\win\.codex\.tmp\plugins'

[marketplaces.openai-primary-runtime]
last_updated = "2026-06-08T00:00:00Z"
source_type = "local"
source = 'C:\Users\win\.cache\codex-runtimes\codex-primary-runtime\plugins\openai-primary-runtime'

[marketplaces.openai-api-curated]
source_type = "local"
source = '\\?\C:\Users\win\.codex\.tmp\plugins'

[marketplaces.openai-curated-remote]
source_type = "local"
source = '\\?\C:\Users\win\.codex\.tmp\plugins-remote'

