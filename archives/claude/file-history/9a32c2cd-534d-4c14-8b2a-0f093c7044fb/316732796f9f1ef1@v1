html,
body,
#app {
  min-height: 100%;
}

.business-shell {
  min-height: 100dvh;
}

.business-sider {
  border-right: 1px solid var(--color-border);
  background: #f7f9fb;
}

.business-sider .ant-layout-sider-children {
  display: flex;
  flex-direction: column;
}

.business-sider .ant-menu {
  background: transparent;
  padding: 0 8px 16px;
}

.business-sider .ant-menu-item,
.business-sider .ant-menu-submenu-title {
  margin-inline: 0 !important;
  width: 100% !important;
  border-radius: 8px !important;
}

.business-sider .ant-menu-item-selected {
  position: relative;
  background: rgba(29, 111, 165, 0.12) !important;
  color: var(--color-primary-strong) !important;
  font-weight: 600;
}

.business-sider .ant-menu-item-selected::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8px;
  bottom: 8px;
  width: 3px;
  border-radius: 0 2px 2px 0;
  background: var(--color-primary);
}

.brand-block {
  padding: 16px 14px 12px;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 10px;
  border-radius: var(--radius-md);
  background: #fff;
  border: 1px solid var(--color-border);
  color: var(--color-primary-strong);
  font-weight: 700;
  font-size: 13px;
  line-height: 1.35;
}

.brand-block p {
  margin: 8px 0 0 2px;
  color: var(--color-text-sub);
  font-size: 12px;
  line-height: 1.4;
  letter-spacing: 0.02em;
}

.business-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  height: auto;
  padding: 12px 22px;
  border-bottom: 1px solid var(--color-border);
  background: #fff !important;
  color: var(--color-text-main) !important;
}

.mock-strip {
  display: flex;
  align-items: center;
  gap: 8px;
  max-width: 760px;
  color: var(--color-primary-strong);
  font-size: 13px;
  line-height: 1.5;
}

.header-actions,
.header-button-row {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  flex-wrap: wrap;
}

.business-content {
  padding: 20px 28px 32px;
}

.business-breadcrumb {
  margin-bottom: 12px;
}

.business-page {
  display: grid;
  gap: 16px;
}

.business-page-header,
.workbook-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  padding: 2px 0 4px;
  border: 0;
  border-radius: 0;
  background: transparent;
}

.business-page-header h1,
.workbook-header h1 {
  display: none;
}

.business-page-header p,
.workbook-header p {
  max-width: 680px;
  margin: 5px 0 0;
  color: var(--color-text-sub);
  font-size: 13px;
  line-height: 1.6;
}

.eyebrow {
  color: var(--color-primary-strong);
  font-size: 13px;
  font-weight: 700;
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.summary-grid.compact {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.summary-tile {
  display: grid;
  gap: 6px;
  text-align: left;
  padding: 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
  color: inherit;
  cursor: pointer;
}

.summary-tile.static {
  cursor: default;
}

.summary-tile span {
  color: var(--color-text-sub);
  font-size: 13px;
}

.summary-tile strong {
  color: var(--color-text-main);
  font-family: var(--font-data);
  font-size: 28px;
  line-height: 1;
}

.summary-tile em {
  color: var(--color-text-sub);
  font-size: 12px;
  font-style: normal;
}

.summary-tile.danger strong {
  color: var(--color-danger);
}

.business-dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: 16px;
  align-items: start;
}

.business-stack {
  display: grid;
  gap: 16px;
}

.business-panel {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
  padding: 16px;
}

.panel-title {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  margin-bottom: 14px;
}

.panel-title.compact {
  align-items: center;
}

.panel-title h2,
.business-panel h2 {
  margin: 0;
  color: var(--color-text-main);
  font-size: 16px;
  font-weight: 700;
  letter-spacing: 0;
}

.panel-title p,
.panel-title span,
.business-panel p {
  margin: 3px 0 0;
  color: var(--color-text-sub);
  font-size: 13px;
  line-height: 1.5;
}

.task-list,
.issue-list,
.link-list {
  display: grid;
  gap: 10px;
}

.business-task-row {
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) 150px;
  gap: 12px;
  align-items: center;
  padding: 12px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-shell);
}

.task-icon {
  display: grid;
  place-items: center;
  width: 34px;
  height: 34px;
  border-radius: var(--radius-md);
  background: rgba(29, 111, 165, 0.1);
  color: var(--color-primary-strong);
}

.business-task-row h3 {
  margin: 0 0 4px;
  font-size: 15px;
}

.business-task-row p {
  margin: 0;
  color: var(--color-text-sub);
  font-size: 13px;
}

.task-meta-line {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 8px;
  color: var(--color-text-sub);
  font-size: 12px;
}

.task-action {
  display: grid;
  justify-items: end;
  gap: 4px;
}

.flow-lane {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
}

.flow-lane.planning {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.flow-lane.top-flow {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.flow-node {
  display: grid;
  gap: 5px;
  min-height: 92px;
  padding: 12px;
  text-align: left;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
  color: inherit;
  cursor: pointer;
}

.flow-node.done {
  background: rgba(47, 143, 91, 0.08);
  border-color: rgba(47, 143, 91, 0.25);
}

.flow-node.active {
  background: rgba(29, 111, 165, 0.08);
  border-color: rgba(29, 111, 165, 0.28);
}

.flow-node span {
  color: var(--color-text-sub);
  font-size: 12px;
  line-height: 1.5;
}

.issue-row,
.link-row {
  display: grid;
  gap: 5px;
  width: 100%;
  padding: 10px;
  text-align: left;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-shell);
  color: inherit;
}

.issue-row.active {
  border-color: var(--color-primary);
  background: rgba(29, 111, 165, 0.08);
}

.issue-row.static,
.link-row.static {
  cursor: default;
}

.issue-row span,
.link-row span,
.issue-row em {
  color: var(--color-text-sub);
  font-size: 12px;
  font-style: normal;
  line-height: 1.5;
}

.mock-note-panel {
  border-style: dashed;
  background: rgba(29, 111, 165, 0.04);
}

.demo-script-panel {
  border-color: rgba(29, 111, 165, 0.28);
  background: #fbfdff;
}

.demo-story-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.demo-story-card {
  display: grid;
  gap: 8px;
  min-height: 176px;
  padding: 14px;
  text-align: left;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
  color: inherit;
  cursor: pointer;
}

.demo-story-card span,
.demo-story-card em,
.demo-story-card p {
  color: var(--color-text-sub);
  font-size: 12px;
  font-style: normal;
  line-height: 1.5;
}

.demo-story-card strong {
  color: var(--color-text-main);
  font-size: 16px;
  line-height: 1.35;
}

.demo-story-card b {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  align-self: end;
  color: var(--color-primary-strong);
  font-size: 13px;
}

.demo-story-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.demo-story-meta em {
  padding: 3px 7px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-soft);
}

.source-context-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 10px 12px;
  border: 1px dashed rgba(29, 111, 165, 0.32);
  border-radius: var(--radius-md);
  background: rgba(29, 111, 165, 0.05);
}

.source-context-strip span {
  color: var(--color-primary-strong);
  font-size: 12px;
  line-height: 1.5;
}

.saved-next-panel {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  border-color: rgba(47, 143, 91, 0.3);
  background: rgba(47, 143, 91, 0.06);
}

.saved-next-panel h2 {
  margin: 0 0 4px;
}

.saved-next-panel p {
  margin: 0;
  color: var(--color-text-sub);
  line-height: 1.6;
}

.assistant-source-strip {
  margin-bottom: 14px;
}

.failure-card-grid {
  display: grid;
  gap: 8px;
  margin-top: 10px;
}

.failure-card {
  display: grid;
  gap: 5px;
  padding: 10px;
  border: 1px solid rgba(217, 137, 36, 0.28);
  border-radius: var(--radius-md);
  background: rgba(217, 137, 36, 0.06);
}

.failure-card strong {
  color: var(--color-text-main);
}

.failure-card span,
.failure-card em {
  color: var(--color-text-sub);
  font-size: 12px;
  font-style: normal;
  line-height: 1.5;
}

.workbook-layout {
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr) 320px;
  gap: 14px;
  align-items: stretch;
  width: 100%;
}

.workbook-layout > .workbook-main {
  min-width: 0;
}

.workbook-sidebar,
.workbook-main,
.business-inspector {
  min-height: 680px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
}

.workbook-sidebar,
.business-inspector {
  padding: 12px;
}

.sidebar-section {
  display: grid;
  gap: 8px;
  margin-bottom: 16px;
}

.sidebar-section h2 {
  margin: 0;
  font-size: 14px;
}

.sheet-button,
.batch-card {
  display: grid;
  gap: 4px;
  width: 100%;
  padding: 10px;
  text-align: left;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-shell);
  color: inherit;
}

.sheet-button.active {
  border-color: var(--color-primary);
  background: rgba(29, 111, 165, 0.08);
}

.sheet-button span,
.batch-card span {
  color: var(--color-text-sub);
  font-size: 12px;
}

.workbook-main {
  overflow: hidden;
}

.workbook-layout.inspector-collapsed {
  grid-template-columns: 240px minmax(0, 1fr);
}

.workbook-layout.sidebar-collapsed {
  grid-template-columns: minmax(0, 1fr) 320px;
}

.workbook-layout.sidebar-collapsed.inspector-collapsed {
  grid-template-columns: minmax(0, 1fr);
}

.workbook-layout.is-focus {
  grid-template-columns: minmax(0, 1fr);
}

.workbook-layout.is-focus .workbook-sidebar {
  display: none;
}

.workbook-layout.is-focus .business-inspector {
  display: none;
}

.workbook-main .vxe-table--body-wrapper,
.workbook-main .vxe-table--footer-wrapper {
  overflow: auto !important;
  scrollbar-color: #8ca5b6 #edf3f6;
  scrollbar-width: auto;
}

.workbook-main .vxe-table--body-wrapper::-webkit-scrollbar,
.workbook-main .vxe-table--footer-wrapper::-webkit-scrollbar {
  width: 12px;
  height: 12px;
}

.workbook-main .vxe-table--body-wrapper::-webkit-scrollbar-thumb,
.workbook-main .vxe-table--footer-wrapper::-webkit-scrollbar-thumb {
  border: 3px solid #edf3f6;
  border-radius: 8px;
  background: #8ca5b6;
}

.workbook-control-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px 14px;
  align-items: center;
  margin-bottom: 12px;
  border: 1px solid var(--color-border);
  background: #fff;
  padding: 8px 12px;
  color: var(--color-text-sub);
  font-size: 12px;
}

.workbook-control-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin-left: auto;
}

.template-import-dialog {
  display: grid;
  gap: 12px;
}

.template-import-dialog > p {
  margin: 0;
  color: var(--color-text-sub);
  font-size: 13px;
  line-height: 1.55;
}

.visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  margin: -1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.import-file-state,
.import-mapping-preview {
  display: grid;
  gap: 4px;
  border: 1px solid var(--color-border);
  background: var(--color-bg-soft);
  padding: 10px 12px;
  font-size: 12px;
}

.import-file-state.error {
  border-color: rgba(197, 83, 83, 0.45);
  background: rgba(197, 83, 83, 0.06);
  color: var(--color-danger);
}

.import-file-state span,
.import-mapping-preview span {
  color: var(--color-text-sub);
  line-height: 1.45;
}

.collection-workspace {
  display: grid;
  grid-template-columns: 250px minmax(0, 1fr);
  gap: 14px;
  align-items: stretch;
}

.collection-template-list,
.collection-preview-panel {
  min-width: 0;
  border: 1px solid var(--color-border);
  background: #fff;
  padding: 12px;
}

.collection-template-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.collection-preview-panel {
  overflow: hidden;
}

.collection-preview-table .vxe-table--body-wrapper {
  overflow: auto !important;
}

.batch-card {
  width: 100%;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: var(--color-bg-soft);
  color: var(--color-text-main);
  text-align: left;
  cursor: pointer;
}

.batch-card.active {
  border-color: rgba(29, 111, 165, 0.42);
  background: rgba(29, 111, 165, 0.06);
}

.sheet-bar,
.sheet-statusbar,
.field-strip {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  border-bottom: 1px solid var(--color-border);
}

.sheet-bar span,
.sheet-statusbar span {
  color: var(--color-text-sub);
  font-size: 12px;
}

.field-strip {
  justify-content: flex-start;
  flex-wrap: wrap;
  background: #fbfdff;
}

.field-strip span {
  padding: 4px 8px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  color: var(--color-text-sub);
  font-size: 12px;
}

.sheet-statusbar {
  border-top: 1px solid var(--color-border);
  border-bottom: 0;
  background: #fbfdff;
}

.segmented-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 6px;
  margin-bottom: 12px;
}

.segmented-tabs button {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-sm);
  background: #fff;
  padding: 7px 8px;
  color: var(--color-text-sub);
}

.segmented-tabs button.active {
  border-color: var(--color-primary);
  background: rgba(29, 111, 165, 0.08);
  color: var(--color-primary-strong);
  font-weight: 700;
}

.inspector-content {
  display: grid;
  gap: 10px;
}

.rule-card,
.formula-card,
.artifact-card,
.reference-card {
  display: grid;
  gap: 6px;
  padding: 10px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-shell);
}

.rule-card p,
.artifact-card p {
  margin: 0;
  color: var(--color-text-sub);
  font-size: 12px;
  line-height: 1.5;
}

.rule-card span,
.formula-card span,
.artifact-card span {
  color: var(--color-text-sub);
  font-size: 12px;
}

.formula-card code,
.formula-code {
  display: block;
  padding: 10px;
  border-radius: var(--radius-md);
  background: #102331;
  color: #d9edf7;
  font-family: Consolas, monospace;
  font-size: 12px;
  white-space: normal;
}

.artifact-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.artifact-card.compact {
  margin-bottom: 10px;
}

.bar-comparison {
  display: grid;
  gap: 12px;
}

.bar-row {
  display: grid;
  grid-template-columns: 80px minmax(0, 1fr) 80px;
  gap: 10px;
  align-items: center;
}

.bar-row div {
  height: 12px;
  border-radius: 999px;
  background: var(--color-bg-soft);
  overflow: hidden;
}

.bar-row i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--color-primary);
}

.chart-placeholder {
  display: grid;
  align-content: end;
  gap: 18px;
  min-height: 260px;
  padding: 24px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: linear-gradient(180deg, #fbfdff 0%, #eef5f9 100%);
}

.chart-line {
  height: 3px;
  width: 86%;
  background: var(--color-primary);
  border-radius: 999px;
  transform: rotate(-4deg);
}

.chart-line.short {
  width: 66%;
  background: var(--color-accent);
  transform: rotate(3deg);
}

.chart-line.alt {
  width: 74%;
  background: var(--color-warning);
  transform: rotate(-1deg);
}

.chart-bars {
  display: flex;
  align-items: end;
  gap: 12px;
  height: 120px;
}

.chart-bars i {
  flex: 1;
  min-width: 24px;
  border-radius: var(--radius-sm) var(--radius-sm) 0 0;
  background: rgba(29, 111, 165, 0.72);
}

.chart-bars i:nth-child(2) {
  height: 72%;
}

.chart-bars i:nth-child(3) {
  height: 92%;
}

.chart-bars i:nth-child(4) {
  height: 54%;
}

.chart-bars i:nth-child(5) {
  height: 80%;
}

.chart-bars i:first-child {
  height: 42%;
}

.chart-bars.wide {
  height: 180px;
}

.assistant-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 390px;
  gap: 16px;
}

.assistant-chat-panel {
  min-height: 560px;
}

.assistant-thread {
  display: grid;
  gap: 12px;
  margin: 18px 0;
}

.assistant-bubble {
  max-width: 760px;
  padding: 12px 14px;
  border-radius: var(--radius-md);
  line-height: 1.7;
}

.assistant-bubble.user {
  justify-self: end;
  background: rgba(29, 111, 165, 0.09);
}

.assistant-bubble.bot {
  background: var(--color-bg-soft);
}

.trace-row {
  display: grid;
  grid-template-columns: 84px minmax(0, 1fr);
  gap: 10px;
  align-items: start;
  padding: 8px 0;
  border-bottom: 1px solid var(--color-border);
}

.trace-row span {
  color: var(--color-text-sub);
  font-size: 12px;
}

.trace-row strong {
  color: var(--color-text-main);
  font-size: 13px;
  line-height: 1.5;
}

.cell-input {
  width: 92px;
}

.cell-note {
  border: 0;
  background: transparent;
  color: var(--color-primary-strong);
  cursor: pointer;
  text-align: left;
}

.cell-note.warning {
  color: var(--color-warning);
}

.cell-note.danger,
.cell-danger-text {
  color: var(--color-danger);
  font-weight: 700;
}

.formula-cell {
  color: var(--color-text-sub);
  font-family: var(--font-data);
}

@media (max-width: 1280px) {
  .business-dashboard-grid,
  .assistant-layout {
    grid-template-columns: 1fr;
  }

  /* Keep collapsed/focus modifiers authoritative; do not force a 2-col grid that squeezes the main table. */
  .workbook-layout {
    grid-template-columns: 220px minmax(0, 1fr) 300px;
  }

  .workbook-layout.inspector-collapsed {
    grid-template-columns: 220px minmax(0, 1fr);
  }

  .workbook-layout.sidebar-collapsed {
    grid-template-columns: minmax(0, 1fr) 300px;
  }

  .workbook-layout.sidebar-collapsed.inspector-collapsed,
  .workbook-layout.is-focus {
    grid-template-columns: minmax(0, 1fr);
  }

  .workbook-layout:not(.inspector-collapsed):not(.is-focus) .business-inspector {
    min-height: auto;
  }

  .workbook-layout.sidebar-collapsed:not(.inspector-collapsed):not(.is-focus) {
    grid-template-columns: minmax(0, 1fr);
  }

  .workbook-layout.sidebar-collapsed:not(.inspector-collapsed):not(.is-focus) .business-inspector {
    grid-column: 1 / -1;
  }
}

@media (max-width: 1024px) {
  .business-header,
  .business-page-header,
  .workbook-header,
  .sheet-bar {
    flex-direction: column;
    align-items: flex-start;
  }

  .summary-grid,
  .summary-grid.compact,
  .flow-lane,
  .flow-lane.planning,
  .flow-lane.top-flow,
  .artifact-grid,
  .demo-story-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .saved-next-panel {
    align-items: flex-start;
    flex-direction: column;
  }

  .workbook-layout {
    grid-template-columns: 1fr;
  }

  .workbook-sidebar,
  .workbook-main,
  .business-inspector {
    min-height: auto;
  }

  .business-task-row {
    grid-template-columns: 36px minmax(0, 1fr);
  }

  .task-action {
    grid-column: 2;
    justify-items: start;
  }
}

@media (max-width: 768px) {
  .business-content {
    padding: 14px;
  }

  .summary-grid,
  .summary-grid.compact,
  .flow-lane,
  .flow-lane.planning,
  .flow-lane.top-flow,
  .artifact-grid,
  .demo-story-grid {
    grid-template-columns: 1fr;
  }

  .business-page-header h1,
  .workbook-header h1 {
    font-size: 21px;
  }

  .bar-row,
  .trace-row {
    grid-template-columns: 1fr;
  }
}

body {
  margin: 0;
  font-family: var(--font-sans);
  color: var(--color-text-main);
  background: var(--color-bg-app);
}

* {
  box-sizing: border-box;
}

a {
  color: inherit;
}

.app-shell {
  min-height: 100vh;
}

.page-shell {
  display: flex;
  flex-direction: column;
  gap: var(--space-lg);
}

.page-toolbar {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-md);
  align-items: flex-start;
}

.page-heading {
  display: flex;
  flex-direction: column;
  gap: var(--space-xs);
}

.page-heading h1 {
  margin: 0;
  font-size: 28px;
  line-height: 1.2;
  font-weight: 700;
  color: var(--color-text-main);
}

.page-heading p {
  margin: 0;
  color: var(--color-text-sub);
  font-size: 14px;
}

.page-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-sm);
  align-items: center;
}

.page-section {
  background: var(--color-bg-panel);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  box-shadow: none;
  padding: 20px;
  min-width: 0;
  overflow: hidden;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--space-md);
  margin-bottom: 16px;
}

.section-title h2,
.section-title h3 {
  margin: 0;
  font-size: 18px;
  line-height: 1.2;
  color: var(--color-text-main);
}

.subtle-text {
  color: var(--color-text-sub);
  font-size: 13px;
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14px;
}

.metric-card {
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 16px;
  min-height: 112px;
}

.metric-card .label {
  display: block;
  color: var(--color-text-sub);
  font-size: 12px;
  margin-bottom: 8px;
}

.metric-card .value {
  display: block;
  font-family: var(--font-data);
  font-size: 28px;
  font-weight: 700;
  line-height: 1;
  color: var(--color-text-main);
}

.metric-card .trend {
  margin-top: 10px;
  color: var(--color-text-sub);
  font-size: 12px;
}

.hero-task-panel {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 360px;
  gap: 16px;
  align-items: stretch;
}

.task-focus {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 18px;
  align-items: start;
  padding: 18px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
  background: #fff;
}

.task-focus h2,
.task-focus h3 {
  margin: 0;
  font-size: 20px;
  line-height: 1.2;
}

.task-focus p {
  margin: 8px 0 0;
  color: var(--color-text-sub);
  line-height: 1.6;
}

.task-meta-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin-top: 16px;
}

.task-meta {
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-soft);
  padding: 10px 12px;
}

.task-meta span {
  display: block;
  color: var(--color-text-sub);
  font-size: 12px;
}

.task-meta strong {
  display: block;
  margin-top: 4px;
  color: var(--color-text-main);
  font-size: 14px;
}

.workbook-card {
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
  padding: 16px;
}

.workbook-card h3 {
  margin: 0;
  font-size: 17px;
}

.workbook-card p {
  margin: 8px 0 0;
  color: var(--color-text-sub);
  font-size: 13px;
  line-height: 1.6;
}

.workbook-header {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: flex-start;
  margin-bottom: 14px;
}

.workbook-source {
  margin-top: 10px;
  padding: 10px 12px;
  border-radius: var(--radius-sm);
  background: var(--color-bg-soft);
  color: var(--color-text-sub);
  font-size: 12px;
  line-height: 1.5;
}

.sheet-list {
  display: grid;
  gap: 10px;
}

.sheet-item {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 12px;
  align-items: start;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-soft);
  padding: 12px;
}

.sheet-item strong {
  display: block;
  margin-bottom: 4px;
}

.sheet-item p {
  margin: 0;
  color: var(--color-text-sub);
  font-size: 12px;
  line-height: 1.5;
}

.sheet-role {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 62px;
  padding: 3px 8px;
  border-radius: var(--radius-sm);
  border: 1px solid transparent;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.sheet-role-input {
  color: var(--color-primary-strong);
  background: rgba(29, 111, 165, 0.1);
  border-color: rgba(29, 111, 165, 0.22);
}

.sheet-role-rollup {
  color: var(--color-accent);
  background: rgba(20, 138, 132, 0.1);
  border-color: rgba(20, 138, 132, 0.22);
}

.sheet-role-calculated {
  color: #687684;
  background: #eef2f5;
  border-color: #d5dde4;
}

.sheet-role-output {
  color: var(--color-warning);
  background: rgba(217, 137, 36, 0.1);
  border-color: rgba(217, 137, 36, 0.22);
}

.legend-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.legend-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 9px;
  border-radius: var(--radius-sm);
  border: 1px solid var(--color-border);
  background: #fff;
  color: var(--color-text-sub);
  font-size: 12px;
}

.legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 2px;
  border: 1px solid transparent;
  flex: 0 0 auto;
}

.legend-dot.blue {
  background: rgba(29, 111, 165, 0.16);
  border-color: rgba(29, 111, 165, 0.34);
}

.legend-dot.green {
  background: rgba(20, 138, 132, 0.16);
  border-color: rgba(20, 138, 132, 0.34);
}

.legend-dot.gray {
  background: #e8edf1;
  border-color: #cdd8e0;
}

.legend-dot.red {
  background: rgba(197, 83, 83, 0.16);
  border-color: rgba(197, 83, 83, 0.34);
}

.legend-row.compact {
  gap: 6px;
}

.rule-list {
  display: grid;
  gap: 10px;
}

.rule-item {
  border: 1px solid var(--color-border);
  border-left: 4px solid var(--color-primary);
  border-radius: var(--radius-md);
  background: #fff;
  padding: 12px;
}

.rule-item.readonly,
.rule-item.formula,
.rule-item.locked {
  border-left-color: var(--color-text-light);
}

.rule-item.warning {
  border-left-color: var(--color-warning);
}

.rule-item strong {
  display: block;
  margin-bottom: 6px;
}

.rule-item p {
  margin: 0;
  color: var(--color-text-sub);
  font-size: 13px;
  line-height: 1.55;
}

.stage-rail {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.stage-step {
  position: relative;
  min-height: 96px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-soft);
  padding: 12px;
}

.stage-step.active {
  border-color: rgba(29, 111, 165, 0.42);
  background: rgba(29, 111, 165, 0.08);
}

.stage-step.done {
  border-color: rgba(47, 143, 91, 0.36);
  background: rgba(47, 143, 91, 0.08);
}

.stage-step strong {
  display: block;
  font-size: 14px;
  color: var(--color-text-main);
}

.stage-step span {
  display: block;
  margin-top: 8px;
  color: var(--color-text-sub);
  font-size: 12px;
  line-height: 1.45;
}

.dense-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.split-grid {
  display: grid;
  grid-template-columns: 320px minmax(0, 1fr);
  gap: 16px;
}

.workbench-grid {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr) 320px;
  gap: 16px;
  align-items: start;
}

.table-workspace {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 320px;
  gap: 16px;
  align-items: start;
}

.workbench-grid > *,
.table-workspace > *,
.split-grid > *,
.dual-grid > *,
.triple-grid > *,
.quad-grid > * {
  min-width: 0;
}

.dual-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.triple-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.quad-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.overview-card {
  min-height: 176px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14px;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
  padding: 16px;
}

.overview-card strong {
  display: block;
  margin-top: 14px;
  font-size: 24px;
  line-height: 1.1;
}

.overview-card p {
  margin: 10px 0 0;
  color: var(--color-text-sub);
  font-size: 13px;
  line-height: 1.6;
}

.flow-strip {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
}

.flow-step {
  min-height: 150px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: var(--color-bg-soft);
  padding: 14px;
}

.flow-step strong {
  color: var(--color-primary-strong);
  font-size: 16px;
}

.flow-step p {
  margin: 0;
  color: var(--color-text-main);
  line-height: 1.6;
  font-size: 13px;
}

.flow-step span {
  color: var(--color-text-sub);
  font-size: 12px;
}

.stack {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 600;
  background: rgba(29, 111, 165, 0.1);
  color: var(--color-primary-strong);
}

.demo-banner {
  border-radius: var(--radius-md);
  border: 1px dashed rgba(29, 111, 165, 0.35);
  background: rgba(29, 111, 165, 0.06);
  color: var(--color-primary-strong);
  padding: 10px 12px;
  font-size: 12px;
}

.status-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.status-item {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12px;
  padding: 12px 14px;
  background: var(--color-bg-soft);
  border-radius: var(--radius-md);
}

.status-item strong {
  display: block;
  margin-bottom: 4px;
  font-size: 14px;
}

.status-item p {
  margin: 0;
  color: var(--color-text-sub);
  font-size: 13px;
}

.compact-list {
  display: grid;
  gap: 8px;
}

.trace-row {
  display: grid;
  grid-template-columns: minmax(76px, 108px) minmax(0, 1fr);
  gap: 10px;
  padding: 8px 0;
  border-bottom: 1px solid var(--color-border);
  font-size: 13px;
}

.trace-row:last-child {
  border-bottom: 0;
}

.trace-row span:first-child {
  color: var(--color-text-sub);
}

.trace-row strong,
.task-meta strong,
.status-item strong,
.status-item p,
.sheet-item p,
.issue-card span,
.quick-link-row span,
.formula-code,
.assistant-log code {
  overflow-wrap: anywhere;
}

.table-caption {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
  color: var(--color-text-sub);
  font-size: 13px;
}

.formula-panel {
  display: flex;
  flex-direction: column;
  gap: 10px;
  border-radius: var(--radius-md);
  border: 1px solid var(--color-border);
  background: linear-gradient(180deg, #fbfdff 0%, #f3f8fb 100%);
