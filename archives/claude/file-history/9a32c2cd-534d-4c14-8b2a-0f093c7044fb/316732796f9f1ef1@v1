  flex-direction: column;
  gap: 14px;
  min-width: 0;
}

.ops-hero {
  display: flex;
  justify-content: space-between;
  gap: 18px;
  align-items: flex-start;
  padding: 18px;
  background: #fff;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-lg);
}

.ops-hero h2 {
  margin: 10px 0 0;
  font-size: 22px;
  line-height: 1.2;
}

.ops-hero p {
  margin: 8px 0 0;
  color: var(--color-text-sub);
}

.ops-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
}

.mini-metric-strip {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 10px;
}

.mini-metric {
  display: grid;
  gap: 4px;
  text-align: left;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: #fff;
  padding: 12px;
