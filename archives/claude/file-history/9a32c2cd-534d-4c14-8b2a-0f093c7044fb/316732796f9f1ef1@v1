  font-style: normal;
}

.mini-metric strong {
  color: var(--color-text-main);
  font-size: 24px;
  line-height: 1;
}

.task-queue {
  display: grid;
  gap: 10px;
}

.task-row {
  width: 100%;
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) 92px;
  gap: 12px;
  align-items: center;
  text-align: left;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-soft);
  padding: 12px;
  cursor: pointer;
}

.task-row.active {
  border-color: rgba(29, 111, 165, 0.4);
  background: rgba(29, 111, 165, 0.06);
}

.task-row-icon {
  color: var(--color-primary-strong);
  font-size: 20px;
}

.task-row-title {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  align-items: center;
}

.task-row-title strong {
  font-size: 15px;
}

.task-row-main p {
  margin: 6px 0 0;
  color: var(--color-text-sub);
  font-size: 13px;
  line-height: 1.5;
}

.task-row-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 8px;
  color: var(--color-text-sub);
  font-size: 12px;
}

.task-row-progress {
  display: grid;
  gap: 4px;
  justify-items: end;
}

.task-row-progress strong {
  font-family: var(--font-data);
  font-size: 20px;
}

.task-row-progress span {
  color: var(--color-text-sub);
  font-size: 12px;
}

.workflow-pair {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.compact-flow {
  display: grid;
  gap: 8px;
}

.compact-flow-step {
  width: 100%;
  display: grid;
  gap: 4px;
  text-align: left;
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  background: var(--color-bg-soft);
  padding: 10px;
  cursor: pointer;
}

