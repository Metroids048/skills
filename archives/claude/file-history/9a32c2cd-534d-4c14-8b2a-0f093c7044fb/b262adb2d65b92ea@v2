  | 'version'
  | 'adjust'
  | 'output'
  | 'admin'
  | 'assistant'
  | 'default'

export interface AssistantMessage {
  id: number
  role: 'user' | 'agent'
  text: string
  time: string
  refs?: string[]
}

export interface AssistantReference {
  title: string
  type: '业务表快照' | '字段说明' | '已审核摘要' | '规范文档'
  scope: string
  version: string
  updatedAt: string
  review: string
}

export interface AssistantTask {
  id: string
  title: string
  mode: AssistantMode
  status: '待复核' | '草稿已生成'
  summary: string
  steps: { title: string; detail: string; status: 'done' | 'active' }[]
  references: string[]
}

interface AssistantProfile {
  key: AssistantProfileKey
  label: string
  mode: AssistantMode
  modeChips: AssistantMode[]
  quickActions: string[]
  starter: string
  task: AssistantTask
  references: AssistantReference[]
}

