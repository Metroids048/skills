export function getTasksForUser(userId?: string) {
  if (!userId) return []
  return businessTasks
    .filter((task) => task.assigneeIds.includes(userId))
    .sort((left, right) => left.priority - right.priority || left.progress - right.progress)
}

export function getPrimaryTask(userId?: string) {
  return getTasksForUser(userId)[0] ?? businessTasks[0]
}

