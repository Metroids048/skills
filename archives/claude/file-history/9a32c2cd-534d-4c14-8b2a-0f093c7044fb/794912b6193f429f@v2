export type BusinessDomain = 'reserve' | 'planning' | 'assistant' | 'admin'

export type TaskStatus = '待处理' | '填报中' | '校验中' | '待复核' | '已保存草案' | '已归档'

export type SheetKind = '输入表' | '汇总表' | '计算表' | '成果表'

export type CellRuleKind = '可填' | '只读' | '公式' | '锁定' | '复核'

export type IssueLevel = '阻断' | '预警' | '复核'

export interface BusinessTask {
  id: string
  title: string
  domain: BusinessDomain
  assigneeIds: string[]
  priority: 1 | 2 | 3
  owner: string
  period: string
  status: TaskStatus
  progress: number
  issueCount: number
  nextAction: string
  route: string
  context: {
    version: string
    focus: string
    issueId?: string
  }
}

export interface WorkflowStep {
  id: string
  title: string
  description: string
  status: 'done' | 'active' | 'wait'
  route: string
}

export interface WorkbookSheet {
  id: string
  name: string
  kind: SheetKind
  source: string
  owner: string
  state: '可填报' | '只读公式' | '需复核' | '可生成' | '[待确认]'
  rows: string
  columns: string
  route: string
}

export interface Workbook {
  id: string
  title: string
  domain: BusinessDomain
  sourceFile: string
  version: string
  owner: string
  purpose: string
  sheets: WorkbookSheet[]
}

export interface CellRule {
  id: string
  sheet: string
  field: string
  kind: CellRuleKind
  rule: string
  owner: string
  confirmState: '样例已表达' | '需业务复核' | '[待确认]'
}

export interface ValidationIssue {
  id: string
  level: IssueLevel
  location: string
  sheet: string
  field: string
  reason: string
  owner: string
  action: string
}

export interface FormulaTrace {
  id: string
  name: string
  expression: string
  sourceSheets: string[]
  outputSheet: string
  status: '样例公式' | '需业务复核' | '[待确认]'
}

export interface VersionComparison {
  id: string
  domain: BusinessDomain
  title: string
  baseVersion: string
  compareVersion: string
  sourceWorkbook: string
  summary: string
  route: string
}

export interface OutputArtifact {
  id: string
  domain: BusinessDomain
  title: string
  source: string
  version: string
  owner: string
  status: '可生成' | '需复核' | '待确认模板' | '已归档'
  route: string
}

export interface PlanningRow {
  id: string
  oilfield: string
  alias: string
  area: string
  state: string
  owner: string
  values: Record<string, { base: number; measure: number; adjustment: number; development: number; total: number }>
  warning?: string
}

export interface ReserveRow {
  id: string
  unit: string
  oilfield: string
  layer: string
  facies: string
  lithology: string
  depth: number
  reserveType: string
  commerciality: string
  nationalLine: number
  internalLine: number
  listedLine: number
  status: '通过' | '缺字段' | '需复核'
}

export interface AiRunRecord {
  id: string
  mode: 'knowledge' | 'query' | 'insight'
  title: string
  question: string
  answer: string
  source: string
  params: string
  version: string
  elapsed: string
  status: '成功样例' | '需复核' | '失败样例'
  references: string[]
}

