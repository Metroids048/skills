# -*- coding: utf-8 -*-
import openpyxl
from openpyxl.utils import get_column_letter

path = r"C:\Users\win\Desktop\敖钦储能项目\原始需求\储量需求\内部储量+未动用储量录入模板.xlsx"
wb = openpyxl.load_workbook(path, data_only=True)

sheet_name = "附表3  油藏综合信息表"
ws = wb[sheet_name]
print("=== ", sheet_name, " max_row=", ws.max_row, "max_col=", ws.max_column)

# Print header rows (assume headers span first few rows, merged cells)
for r in range(1, min(6, ws.max_row + 1)):
    row_vals = []
    for c in range(1, ws.max_column + 1):
        v = ws.cell(row=r, column=c).value
        if v is not None:
            row_vals.append(f"{get_column_letter(c)}{r}={v}")
    print(f"--- row {r} ({len(row_vals)} non-empty) ---")
    for item in row_vals:
        print(item)
