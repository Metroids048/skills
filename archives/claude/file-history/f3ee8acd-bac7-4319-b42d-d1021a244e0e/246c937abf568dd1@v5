    function runDemoStepV2(step, plan) {
      if (!step) return;
      if (step.type === "say") {
        speakV2(step.text);
        return;
      }
      if (step.type === "highlight") {
        highlightTargetV2(step.selector);
        return;
      }
      if (step.type === "pulseTarget") {
        highlightTargetV2(step.selector, "demo-pulse-target");
        return;
      }
      if (step.type === "fillMock") {
        fillMockTargetV2(step.selector, step.value);
        return;
      }
      if (step.type === "advanceStep") {
        advanceStepV2(step.selector);
        return;
      }
      if (step.type === "openModal") {
        if (stateV2.pendingModalPlan) {
          const pendingPlan = stateV2.pendingModalPlan;
          stateV2.pendingModalPlan = null;
          openModalV2(pendingPlan);
        }
      }
    }

    function runDemoScriptV2(scriptId, plan) {
      const script = DEMO_SCRIPT_LIBRARY[scriptId];
      if (!script) return;
      clearScriptTimersV2();
      elsV2.modalCard.classList.add("script-running");
      script.steps.forEach((step) => {
        const timer = window.setTimeout(() => runDemoStepV2(step, plan), step.delay || 0);
        stateV2.scriptTimers.push(timer);
      });
      if (script.finalSpeech) {
        const lastDelay = Math.max(...script.steps.map((step) => step.delay || 0), 0) + 220;
        const timer = window.setTimeout(() => {
          setPetStatusV2(script.finalSpeech);
        }, lastDelay);
        stateV2.scriptTimers.push(timer);
      }
    }

