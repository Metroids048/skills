    function streamIntoElement(targetEl, text, options) {
      var speed = (options && options.speed) || 22;
      var onDone = (options && options.onDone) || function() {};
      var index = 0;
      targetEl.textContent = "";
      var tick = function() {
        index += Math.max(1, text[index] === " " ? 2 : 1);
        targetEl.textContent = text.slice(0, index);
        if (index < text.length) {
          window.setTimeout(tick, speed);
        } else {
          onDone();
        }
      };
      window.setTimeout(tick, 30);
    }

    function appendUserTurnV2(userText) {
      var thread = document.getElementById("dialog-thread-v2");
      if (!thread) return;
      thread.insertAdjacentHTML("beforeend",
        '<div class="chat-bubble user">' + escapeHtmlV2(userText) + '</div>');
      thread.scrollTop = thread.scrollHeight;
    }

    function appendAiTurnStreamingV2(replyText) {
      var thread = document.getElementById("dialog-thread-v2");
      if (!thread) return;
      var thinkingId = "thinking-" + Date.now();
      thread.insertAdjacentHTML("beforeend",
        '<div class="chat-bubble ai thinking" id="' + thinkingId + '">' +
        '<span class="thinking-dots"><i></i><i></i><i></i></span></div>');
      thread.scrollTop = thread.scrollHeight;
      var delay = 500 + Math.floor(Math.random() * 500);
      window.setTimeout(function() {
        var el = document.getElementById(thinkingId);
        if (!el) return;
        el.classList.remove("thinking");
        el.innerHTML = "";
        streamIntoElement(el, replyText, {
          speed: 22,
          onDone: function() {
            thread.scrollTop = thread.scrollHeight;
            if (stateV2.modalVoiceLoop) {
              window.setTimeout(function() { autoRelistenModalV2(); }, 900);
            }
          }
        });
      }, delay);
    }

