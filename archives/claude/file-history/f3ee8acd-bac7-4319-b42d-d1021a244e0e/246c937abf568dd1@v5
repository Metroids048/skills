        openModalV2(metricPlan);
        runDemoScriptV2(plan.scriptId, metricPlan);
        speakV2(`${metricPlan.entities.period}的${metricPlan.metric.label}已经先帮你打开。`);
        return;
      }
      executeWorkspaceV2(plan);
    }

    function processCommandV2(text, source = "manual") {
      const commandText = String(text || "").trim();
      if (!commandText) return;
      const voiceDriven = source === "voice";
      if (!voiceDriven) elsV2.mainInput.value = commandText;
      setStateV2("thinking", voiceDriven ? 760 : 520);
      if (voiceDriven) updateVoicePresenceV2("voice", "thinking", commandText);
      else setPetStatusV2(`我听到你的需求是：${commandText}`);
      const route = resolveRouteV2(commandText);
      if (!route) {
        if (stateV2.currentPlan) {
          handleFollowV2(stateV2.currentPlan, commandText);
          return;
        }
        setStateV2("idle");
        showBubbleV2({
          title: "能再说具体一点吗",
          copy: "告诉我想处理什么业务、查什么数据，还是打开哪个页面，我来帮你调度。",
          quickItems: DEMO_COMMANDS_V2,
          sticky: false
        });
        return;
      }
      const plan = buildPlanV2(route, commandText, source);
      if (!plan) return;
      if (plan.action === "wake") {
        setStateV2("awake", 1600);
        setPetStatusV2("我在，你继续说业务需求就行");
        toastV2("海小南已唤醒", "success", "语音唤醒");
        return;
      }
      if (plan.action === "answer_direct") {
        executeAnswerV2(plan);
        return;
      }
      if (plan.action === "run_demo_script") {
        executeScriptedFlowV2(plan);
        return;
      }
      executeWorkspaceV2(plan);
    }

    function simulateCommandV2(phrase) {
      hideBubbleV2();
      showListenOverlayV2("正在为你处理", phrase);
      setStateV2("thinking");
      window.setTimeout(() => {
        hideListenOverlayV2();
        processCommandV2(phrase, "fallback");
      }, 620);
    }

    function queueVoiceCommandV2(text, source = "voice") {
      const content = String(text || "").trim();
      if (!content) return;
      updateVoicePresenceV2("voice", "thinking", content);
      window.setTimeout(() => processCommandV2(content, source), 260);
    }

    async function ensureVoicePermissionV2() {
      if (stateV2.voicePermissionGranted) return;
      if (!window.isSecureContext && location.hostname !== "localhost" && location.hostname !== "127.0.0.1") {
        throw new Error("当前页面不是安全上下文，请通过 localhost 打开 demo。");
      }
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
        throw new Error("当前浏览器不支持麦克风能力，请使用 Chrome 或 Edge。");
      }
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      stream.getTracks().forEach((track) => track.stop());
      stateV2.voicePermissionGranted = true;
    }

    function createRecognitionV2({ continuous = false, interimResults = true } = {}) {
      const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
      if (!SpeechRecognition) return null;
      const recognition = new SpeechRecognition();
      recognition.lang = "zh-CN";
      recognition.continuous = continuous;
      recognition.interimResults = interimResults;
      recognition.maxAlternatives = 1;
      return recognition;
    }

    async function autoPassiveListenV2() {
      try {
        await ensureVoicePermissionV2();
      } catch (e) { return; }
      stateV2.passiveEnabled = true;

      function startPassiveInstance() {
        if (!stateV2.passiveEnabled) return;
        const passive = createRecognitionV2({ continuous: true, interimResults: true });
        if (!passive) return;
        stateV2.passiveRecognition = passive;
        passive.onresult = (e) => {
          let interim = "";
          let finalChunk = "";
          for (let i = e.resultIndex; i < e.results.length; i++) {
            if (e.results[i].isFinal) finalChunk += e.results[i][0].transcript;
            else interim += e.results[i][0].transcript;
          }
          const display = (finalChunk || interim).trim();
          if (!display) return;
          const val = normalizeV2(display);
          const hasWake = includesAnyV2(val, WAKE_WORDS);
          if (hasWake || stateV2.awaitingCommand) {
            showListenOverlayV2(stateV2.awaitingCommand ? "正在聆听..." : "已唤醒", display);
          }
          if (finalChunk.trim()) {
            processVoiceSpeechPassiveV2(finalChunk.trim());
          }
        };
        passive.onend = () => {
          if (stateV2.passiveEnabled) {
            window.setTimeout(startPassiveInstance, 600);
          }
        };
        passive.onerror = () => {};
        try { passive.start(); } catch (_) {}
      }

      startPassiveInstance();
    }

    function processVoiceSpeechPassiveV2(text) {
      const value = normalizeV2(text);
      if (!value) return;
      const hasWakeWord = includesAnyV2(value, WAKE_WORDS);
      let command = value;
      WAKE_WORDS.forEach((w) => { command = command.replaceAll(normalizeV2(w), "").trim(); });

      if (hasWakeWord && !command) {
        stateV2.awaitingCommand = true;
        setStateV2("awake", 2000);
        showListenOverlayV2("已唤醒", "请说出你的业务指令...");
        setPetStatusV2("我在，你直接说业务需求就行");
        if (stateV2.awaitCommandTimer) window.clearTimeout(stateV2.awaitCommandTimer);
        stateV2.awaitCommandTimer = window.setTimeout(() => {
          stateV2.awaitingCommand = false;
          hideListenOverlayV2();
        }, 8000);
        window.setTimeout(() => {
          if (stateV2.awaitingCommand) setStateV2("listening");
        }, 600);
        return;
      }

      if (command && (hasWakeWord || stateV2.awaitingCommand)) {
        stateV2.awaitingCommand = false;
        if (stateV2.awaitCommandTimer) window.clearTimeout(stateV2.awaitCommandTimer);
        showListenOverlayV2("正在理解...", command);
        updateVoicePresenceV2("voice", "thinking", command);
        queueVoiceCommandV2(command, "voice");
        return;
      }
      // 无唤起词且不在等待状态：完全静默
    }

    function stopVoiceV2(forceStop = false) {
      stateV2.textListening = false;
      stateV2.standbyEnabled = false;
      stateV2.directListening = false;
      elsV2.micTrigger.classList.remove("listening");
      if (elsV2.directVoiceTrigger) elsV2.directVoiceTrigger.classList.remove("active", "listening");
      hideListenOverlayV2();
      stopVoiceMeterV2();
      stateV2.wakeUntil = 0;
      if (forceStop && stateV2.textRecognition) {
        try { stateV2.textRecognition.stop(); } catch (e) {}
      }
      setStateV2(restingStateV2());
      setPetStatusV2("你可以直接说话，也可以点我看业务指令");
    }

    function processVoiceSpeechV2(text) {
      const value = normalizeV2(text);
      if (!value) return;
      const hasWakeWord = includesAnyV2(value, WAKE_WORDS);
      let command = value;
      WAKE_WORDS.forEach((w) => { command = command.replaceAll(normalizeV2(w), "").trim(); });
      if (hasWakeWord && !command) {
        setStateV2("awake", 1600);
        setPetStatusV2("我在，你继续说业务需求就行");
        toastV2("海小南已唤醒", "success", "语音唤醒");
        return;
      }
      if (command) {
        if (hasWakeWord) setStateV2("awake", 1200);
        elsV2.mainInput.value = command;
        queueVoiceCommandV2(command, "voice");
      }
    }

    function toggleVoiceV2() {
      if (stateV2.textListening || stateV2.standbyEnabled) {
        stopVoiceV2(true);
        return;
      }
      if (!createRecognitionV2({ continuous: true, interimResults: true })) {
        toastV2("当前浏览器不支持语音识别，请使用文本输入。", "warning", "语音识别");
        return;
      }
      stateV2.standbyEnabled = true;
      elsV2.micTrigger.classList.add("listening");
      setStateV2("listening");
      setPetStatusV2("我在听，直接说业务需求");
      showListenOverlayV2("正在聆听...", "直接说出业务需求，我会自动识别并替你调度。");

      function startActiveInstance() {
        if (!stateV2.standbyEnabled) return;
        const rec = createRecognitionV2({ continuous: true, interimResults: true });
        if (!rec) return;
        stateV2.textRecognition = rec;
        stateV2.textListening = true;
        let finalText = "";
        rec.onresult = (event) => {
          let interim = "";
          for (let i = event.resultIndex; i < event.results.length; i += 1) {
            const transcript = event.results[i][0].transcript;
            if (event.results[i].isFinal) finalText += transcript;
            else interim += transcript;
          }
          const display = (finalText + interim).trim();
          if (display) showListenOverlayV2("正在聆听...", display);
          setPetStatusV2(interim ? "正在听：" + display : "识别完成");
        };
        rec.onerror = (event) => {
          if (event.error === "no-speech") return; // standby 模式下无声不中断
          const errMap = { "not-allowed": "请在浏览器设置中开启麦克风权限后重试。", "network": "语音识别需要网络连接。", "service-not-allowed": "语音服务暂不可用，请使用文本输入。" };
          toastV2(errMap[event.error] || "语音识别错误：" + event.error, "error", "语音识别");
          stopVoiceV2(false);
        };
        rec.onend = () => {
          stateV2.textListening = false;
          elsV2.micTrigger.classList.remove("listening");
          const command = finalText.trim();
          if (command) {
            elsV2.mainInput.value = command;
            processVoiceSpeechV2(command);
          }
          if (stateV2.standbyEnabled) {
            window.setTimeout(() => {
              if (!stateV2.standbyEnabled) return;
              elsV2.micTrigger.classList.add("listening");
              setPetStatusV2("继续听，直接说需求");
              startActiveInstance();
            }, 400);
          }
        };
        try {
          rec.start();
        } catch (e) {
          stateV2.textListening = false;
          stopVoiceV2(false);
          toastV2("语音识别启动失败：" + e.message + "，请使用文本输入。", "error", "语音识别");
        }
      }

      startActiveInstance();
    }

    function bindHistoryV2() {
      const update = () => {
        const keyword = elsV2.historySearch.value.trim().toLowerCase();
        elsV2.clearSearch.style.display = keyword ? "block" : "none";
        let visibleCount = 0;
        elsV2.historyItems.forEach((item) => {
          const title = item.dataset.title.toLowerCase();
          const matched = !keyword || title.includes(keyword);
          item.classList.toggle("hidden", !matched);
          if (matched) visibleCount += 1;
        });
        elsV2.searchEmpty.style.display = visibleCount === 0 ? "block" : "none";
      };
      elsV2.historySearch.addEventListener("input", update);
      elsV2.clearSearch.addEventListener("click", () => {
        elsV2.historySearch.value = "";
        update();
      });
    }

    function bindModalShellV2() {
      elsV2.modalClose.addEventListener("click", closeModalV2);
      elsV2.modalLayer.addEventListener("click", (event) => {
        if (event.target === elsV2.modalLayer) closeModalV2();
      });
    }

    function bindTopV2() {
      elsV2.micTrigger.addEventListener("click", toggleVoiceV2);
      elsV2.listenCancel.addEventListener("click", () => stopVoiceV2(true));
      elsV2.sendTrigger.addEventListener("click", () => {
        const value = elsV2.mainInput.value.trim();
        if (!value) {
          toastV2("请输入内容，或直接点击麦克风说一句话。", "info", "海小南提示");
          return;
        }
        processCommandV2(value, "manual");
      });
      elsV2.mainInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter" && !event.shiftKey) {
          event.preventDefault();
          elsV2.sendTrigger.click();
        }
      });
    }

    function bindDigitalHumanV2() {
      const pet = elsV2.digitalHuman;
      let dragging = false;
      let dragStartX = 0;
      let dragStartY = 0;
      let offsetX = 0;
      let offsetY = 0;
      let lastMoveX = 0;
      let lastMoveY = 0;
      let lastMoveAt = 0;

      const snapToEdge = () => {
        const rect = pet.getBoundingClientRect();
        const snapX = rect.left < window.innerWidth / 2 ? 14 : window.innerWidth - pet.offsetWidth - 14;
        pet.style.left = `${snapX}px`;
        pet.style.right = "auto";
        pet.style.bottom = "auto";
        positionBubbleV2();
      };

      pet.addEventListener("mouseenter", (event) => {
        if (!dragging) setStateV2("hover");
        dispatchAvatarEventV2("pointermove", { clientX: event.clientX, clientY: event.clientY });
        if (!pet.classList.contains("show-bubble")) {
          showBubbleV2({
            title: "点我，或者直接说“小南小南”",
            copy: stateV2.standbyEnabled
              ? "我已经在持续收听，你也可以点下面几个重点场景。"
              : "单击会展开业务指令，双击会开启语音持续收听。",
            quickItems: DEMO_COMMANDS_V2,
            sticky: false
          });
        }
      });

      pet.addEventListener("mouseleave", () => {
        if (!dragging) setStateV2(restingStateV2());
        dispatchAvatarEventV2("pointerleave");
        pet.style.removeProperty("--face-x");
        pet.style.removeProperty("--face-y");
      });

      pet.addEventListener("mousemove", (event) => {
        if (!dragging) dispatchAvatarEventV2("pointermove", { clientX: event.clientX, clientY: event.clientY });
        const rect = pet.getBoundingClientRect();
        const cx = rect.left + rect.width / 2;
        const cy = rect.top + rect.height * 0.38;
        const dx = (event.clientX - cx) / (rect.width * 0.6);
        const dy = (event.clientY - cy) / (rect.height * 0.6);
        pet.style.setProperty("--face-x", (Math.max(-3, Math.min(3, dx * 3))).toFixed(2) + "px");
        pet.style.setProperty("--face-y", (Math.max(-2, Math.min(2, dy * 2))).toFixed(2) + "px");
      });

      pet.addEventListener("click", (event) => {
        const dx = Math.abs(event.clientX - dragStartX);
        const dy = Math.abs(event.clientY - dragStartY);
        if (stateV2.dragMoved || dx > 5 || dy > 5) {
          stateV2.dragMoved = false;
          return;
        }
        setStateV2("awake", 1100);
        if (pet.classList.contains("show-bubble")) hideBubbleV2();
        else {
          showBubbleV2({
            title: "海小南业务指令",
            copy: stateV2.standbyEnabled
              ? "我已经在持续收听，你也可以点下面的重点场景快速继续。"
              : "如果现场语音受环境影响，直接点下面的命令，也会走同一条智能调度链路。",
            quickItems: DEMO_COMMANDS_V2,
            sticky: false
          });
        }
      });

      pet.addEventListener("dblclick", () => {
        toggleVoiceV2();
        setStateV2("awake", 1400);
      });

      const startDrag = (clientX, clientY) => {
        const rect = pet.getBoundingClientRect();
        dragging = true;
        stateV2.dragMoved = false;
        dragStartX = clientX;
        dragStartY = clientY;
        offsetX = clientX - rect.left;
        offsetY = clientY - rect.top;
        lastMoveX = clientX;
        lastMoveY = clientY;
        lastMoveAt = performance.now();
        setStateV2("dragging");
        dispatchAvatarEventV2("dragstart", { clientX, clientY });
      };

      const moveDrag = (clientX, clientY) => {
        if (!dragging) return;
        stateV2.dragMoved = true;
        const maxX = window.innerWidth - pet.offsetWidth - 8;
        const maxY = window.innerHeight - pet.offsetHeight - 8;
        const nextX = Math.min(Math.max(clientX - offsetX, 8), maxX);
        const nextY = Math.min(Math.max(clientY - offsetY, 72), maxY);
        const centerX = nextX + pet.offsetWidth / 2;
        const tilt = ((clientX - centerX) / 13).toFixed(2);
        const deltaX = clientX - dragStartX;
        const deltaY = clientY - dragStartY;
        const travel = Math.min(1.4, Math.hypot(deltaX, deltaY) / 120);
        const pull = Math.min(1.35, Math.abs(deltaX) / 110);
        const lift = Math.min(1.1, Math.max(0, dragStartY - clientY) / 90);
        const now = performance.now();
        const dt = Math.max(16, now - lastMoveAt);
        const velocityX = Math.max(-1.2, Math.min(1.2, (clientX - lastMoveX) / dt * 10));
        const velocityY = Math.max(-1.2, Math.min(1.2, (clientY - lastMoveY) / dt * 10));
        pet.style.left = `${nextX}px`;
        pet.style.top = `${nextY}px`;
        pet.style.right = "auto";
        pet.style.bottom = "auto";
        pet.style.setProperty("--drag-tilt", `${tilt}deg`);
        dispatchAvatarEventV2("dragmove", { clientX, clientY, tilt: Number(tilt), pull, lift, travel, velocityX, velocityY });
        lastMoveX = clientX;
        lastMoveY = clientY;
        lastMoveAt = now;
        positionBubbleV2();
      };

      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        pet.style.removeProperty("--drag-tilt");
        dispatchAvatarEventV2("dragend");
        snapToEdge();
        clearDragReleaseTimerV2();
        stateV2.dragReleaseTimer = window.setTimeout(() => {
          setStateV2("success", 780);
          stateV2.dragReleaseTimer = null;
        }, 220);
      };

      pet.addEventListener("mousedown", (event) => startDrag(event.clientX, event.clientY));
      document.addEventListener("mousemove", (event) => moveDrag(event.clientX, event.clientY));
      document.addEventListener("mouseup", endDrag);
      pet.addEventListener("touchstart", (event) => {
        const touch = event.touches[0];
        startDrag(touch.clientX, touch.clientY);
      }, { passive: true });
      document.addEventListener("touchmove", (event) => {
        if (!dragging) return;
        const touch = event.touches[0];
        moveDrag(touch.clientX, touch.clientY);
      }, { passive: true });
      document.addEventListener("touchend", endDrag, { passive: true });
      window.addEventListener("resize", positionBubbleV2);
    }

    function renderGridV2() {
      elsV2.agentGrid.innerHTML = AGENT_REGISTRY_V2.slice().sort((a, b) => a.order - b.order).map((agent) => `
        <button class="agent-card" type="button" data-agent-id="${agent.id}" aria-label="${agent.name}">
          <img src="${agent.icon}" alt="${agent.name}">
          <div class="agent-meta">
            <strong>${agent.name}</strong>
            <span>${agent.subtitle}</span>
          </div>
        </button>
      `).join("");
      [...elsV2.agentGrid.querySelectorAll(".agent-card")].forEach((card) => {
        card.addEventListener("click", () => {
          const agent = getAgentV2(card.dataset.agentId);
          if (!agent) return;
          processCommandV2(agent.prompt, "card");
        });
      });
    }

    function renderToolsV2() {
      const html = TOOL_BUTTONS_V2.map((tool) => `
        <button class="tool-pill ${TOOL_STATE_V2[tool.key] ? "active" : ""}" data-tool-key="${tool.key}" type="button">
          <span>${tool.icon}</span>
          <span>${tool.label}</span>
        </button>
      `).join("");
      elsV2.toolRow.insertAdjacentHTML("beforeend", html);
      [...elsV2.toolRow.querySelectorAll(".tool-pill")].forEach((button) => {
        button.addEventListener("click", () => {
          const key = button.dataset.toolKey;
          TOOL_STATE_V2[key] = !TOOL_STATE_V2[key];
          if (key === "freeChat") TOOL_STATE_V2.freeChat = true;
          button.classList.toggle("active", TOOL_STATE_V2[key]);
          toastV2(TOOL_STATE_V2[key] ? `已开启：${findToolLabelV2(key)}` : `已关闭：${findToolLabelV2(key)}`, "info", "工具状态");
        });
      });
    }

    function initialBubbleV2() {
      window.setTimeout(() => {
        showBubbleV2({
          title: "海小南已就绪",
          copy: "你可以点左下麦克风开始语音输入，也可以点下面几个重点场景。",
          quickItems: DEMO_COMMANDS_V2,
          sticky: false
        });
      }, 900);
    }

    async function initV2Demo() {
      try {
        renderGridV2();
        renderToolsV2();
        bindHistoryV2();
        bindModalShellV2();
        bindTopV2();
        bindDigitalHumanV2();
        setStateV2("idle");
        scheduleAmbientV2();
        window.setTimeout(() => autoPassiveListenV2(), 1400);
        document.addEventListener("pointerdown", () => ensureAvatarRuntimeV2(), { once: true });
      } catch (e) {
        console.error("initV2Demo failed:", e);
      }
    }

    initV2Demo();
  </script>
</body>
