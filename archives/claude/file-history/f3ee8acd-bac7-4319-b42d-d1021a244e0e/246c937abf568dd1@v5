    .pet.awake .pet-core {
      animation: petAwakeEnhanced 0.58s ease-in-out infinite alternate;
    }

    @keyframes petAwakeEnhanced {
      from { transform: translateY(-4px) rotate(-5deg) scale(1.09); }
      to { transform: translateY(-10px) rotate(5deg) scale(1.12); }
