<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>海小南 - 智能生产经营平台</title>
  <style>
    :root {
      --bg: #f8f9fd;
      --panel: #ffffff;
      --line: #e7ebf3;
      --line-strong: #d7ddea;
      --text: #1e2430;
      --muted: #8a95aa;
      --primary: #5a73f7;
      --primary-strong: #4a61e6;
      --primary-soft: #eef2ff;
      --blue: #4f6ef7;
      --sky: #75a8ff;
      --teal: #2bb7a9;
      --success: #18b26b;
      --warning: #f59e0b;
      --danger: #ff5f63;
      --shadow: 0 18px 48px rgba(71, 89, 130, 0.12);
      --shadow-soft: 0 10px 24px rgba(71, 89, 130, 0.08);
      --radius: 20px;
      --sidebar-width: 264px;
      --header-height: 56px;
      --font: "PingFang SC", "Microsoft YaHei", "Segoe UI", sans-serif;
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      font-family: var(--font);
      background:
        radial-gradient(circle at 75% 18%, rgba(104, 132, 255, 0.12), transparent 24%),
        radial-gradient(circle at 55% 48%, rgba(88, 168, 255, 0.08), transparent 30%),
        linear-gradient(180deg, #fcfdff 0%, #f7f9fd 100%);
      color: var(--text);
      overflow: hidden;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    button {
      border: 0;
      background: none;
      cursor: pointer;
    }

    .app-shell {
      height: 100vh;
      display: grid;
      grid-template-columns: var(--sidebar-width) 1fr;
      grid-template-rows: var(--header-height) 1fr;
      grid-template-areas:
        "sidebar header"
        "sidebar main";
      position: relative;
    }

    .sidebar {
      grid-area: sidebar;
      background: rgba(255, 255, 255, 0.9);
      border-right: 1px solid var(--line-strong);
      display: flex;
      flex-direction: column;
      min-width: 0;
      position: relative;
      z-index: 3;
    }

    .header {
      grid-area: header;
      background: rgba(255, 255, 255, 0.86);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--line-strong);
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 24px;
      position: relative;
      z-index: 4;
    }

    .main {
      grid-area: main;
      min-width: 0;
      min-height: 0;
      overflow: auto;
      position: relative;
      padding: 26px 24px 24px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 16px 10px 18px;
      border-bottom: 1px solid rgba(227, 232, 241, 0.85);
    }

    .brand img {
      width: 28px;
      height: 28px;
      border-radius: 9px;
      object-fit: cover;
    }

    .brand-title {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }

    .brand-title strong {
      font-size: 13px;
      color: #202739;
    }

    .brand-title span {
      margin-top: 3px;
      font-size: 11px;
      color: #95a0ff;
      font-weight: 600;
    }

    .new-chat-wrap {
      padding: 16px 12px 10px;
    }

    .new-chat-btn {
      width: 100%;
      height: 40px;
      border-radius: 14px;
      color: #fff;
      background: linear-gradient(135deg, #5971f7 0%, #4f6ef7 45%, #5475ff 100%);
      box-shadow: 0 10px 24px rgba(79, 110, 247, 0.28);
      font-size: 14px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .search-box {
      padding: 10px 12px 8px;
      position: relative;
    }

    .search-box input {
      width: 100%;
      height: 31px;
      border-radius: 14px;
      border: 1px solid #d8dde8;
      background: #f7f8fb;
      color: #5c6475;
      padding: 0 34px 0 36px;
      outline: none;
      font-size: 12px;
    }

    .search-box svg,
    .search-box .clear-search {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      color: #a7aec1;
    }

    .search-box svg {
      left: 24px;
      width: 14px;
      height: 14px;
      pointer-events: none;
    }

    .clear-search {
      right: 24px;
      font-size: 14px;
      display: none;
    }

    .sidebar-tabs {
      display: flex;
      gap: 4px;
      padding: 6px 14px 0;
    }

    .sidebar-tab {
      flex: 1;
      height: 30px;
      border-radius: 8px;
      font-size: 12px;
      color: #9aa2b3;
      background: transparent;
      transition: 0.2s ease;
    }

    .sidebar-tab.active {
      background: #edf4ff;
      color: #1f69b7;
      font-weight: 700;
    }

    .history-list {
      flex: 1;
      overflow: auto;
      padding: 8px 8px 12px;
    }

    .history-item {
      display: flex;
      gap: 12px;
      padding: 10px 12px;
      border-radius: 12px;
      transition: 0.2s ease;
      cursor: pointer;
      position: relative;
    }

    .history-item:hover {
      background: rgba(237, 241, 248, 0.8);
    }

    .history-item.hidden {
      display: none;
    }

    .history-avatar {
      width: 22px;
      height: 22px;
      border-radius: 999px;
      background: linear-gradient(135deg, #34c475 0%, #1f9f55 100%);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-top: 3px;
      flex-shrink: 0;
    }

    .history-content {
      min-width: 0;
    }

    .history-title {
      font-size: 13px;
      color: #242d3e;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 180px;
    }

    .history-time {
      font-size: 12px;
      color: #a1aab8;
      margin-top: 5px;
    }

    .search-empty {
      padding: 28px 16px 18px;
      color: #9ca7b9;
      text-align: center;
      font-size: 13px;
      display: none;
    }

    .sidebar-footer {
      border-top: 1px solid rgba(227, 232, 241, 0.9);
      padding: 12px 14px 18px;
      font-size: 14px;
      color: #626e86;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .folder-icon {
      width: 18px;
      height: 14px;
      position: relative;
      background: linear-gradient(180deg, #f8c84d 0%, #e8b229 100%);
      border-radius: 2px 2px 3px 3px;
      box-shadow: inset 0 -1px 0 rgba(0, 0, 0, 0.08);
    }

    .folder-icon::before {
      content: "";
      position: absolute;
      left: 2px;
      top: -3px;
      width: 8px;
      height: 4px;
      border-radius: 2px 2px 0 0;
      background: #ffd973;
    }

    .header-nav {
      height: 40px;
      padding: 4px 10px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.96);
      border: 1px solid rgba(226, 231, 241, 0.96);
      display: flex;
      align-items: center;
      gap: 2px;
      box-shadow: var(--shadow-soft);
    }

    .nav-item {
      height: 32px;
      padding: 0 16px;
      border-radius: 999px;
      display: flex;
      align-items: center;
      gap: 7px;
      color: #606c83;
      font-size: 14px;
      transition: 0.2s ease;
      position: relative;
    }

    .nav-item:hover,
    .nav-item.active {
      color: #2c3650;
      background: rgba(241, 244, 251, 0.96);
    }

    .nav-item svg {
      width: 15px;
      height: 15px;
      stroke-width: 1.9;
    }

    .header-right {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .header-icon-btn {
      width: 32px;
      height: 32px;
      border-radius: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #2d3445;
      transition: 0.2s ease;
    }

    .header-icon-btn:hover {
      background: rgba(239, 242, 249, 0.92);
    }

    .header-icon-btn svg {
      width: 17px;
      height: 17px;
      stroke-width: 1.9;
    }

    .user-info {
      display: flex;
      align-items: center;
      gap: 10px;
      padding-left: 12px;
      border-left: 1px solid var(--line-strong);
      margin-left: 4px;
    }

    .user-text {
      text-align: right;
      line-height: 1.15;
    }

    .user-text strong {
      display: block;
      font-size: 14px;
      color: #2c3550;
    }

    .user-text span {
      display: block;
      font-size: 11px;
      color: #9ba5b9;
      margin-top: 3px;
    }

    .avatar-badge {
      width: 32px;
      height: 32px;
      border-radius: 12px;
      background: linear-gradient(135deg, #6276ff 0%, #4662f4 100%);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 13px;
      font-weight: 700;
    }

    .home-stage {
      width: min(1120px, calc(100% - 18px));
      margin: 0 auto;
      min-height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-bottom: 22px;
      position: relative;
    }

    .hero {
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-top: 30px;
      position: relative;
    }

    .hero-art {
      width: min(920px, 92%);
      height: 170px;
      object-fit: cover;
      object-position: center;
      opacity: 0.86;
      filter: saturate(0.92);
      user-select: none;
      pointer-events: none;
    }

    .hero-copy {
      position: absolute;
      top: 34px;
      text-align: center;
      width: min(820px, 86%);
    }

    .hero-copy h1 {
      margin: 0;
      font-size: 22px;
      line-height: 1.3;
      font-weight: 900;
      color: #4d57d7;
      letter-spacing: 0.01em;
    }

    .hero-copy p {
      margin: 10px auto 0;
      font-size: 17px;
      color: #637188;
      line-height: 1.55;
      max-width: 660px;
    }

    .agent-board {
      width: min(900px, 100%);
      margin-top: 18px;
      border-radius: 20px;
      padding: 26px 24px;
      background:
        linear-gradient(135deg, rgba(232, 224, 255, 0.82) 0%, rgba(231, 239, 252, 0.72) 52%, rgba(227, 247, 243, 0.78) 100%);
      border: 1px solid rgba(220, 228, 242, 0.88);
      box-shadow: 0 12px 30px rgba(91, 116, 177, 0.1);
    }

    .agent-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 16px;
    }

    .agent-card {
      height: 66px;
      background: rgba(255, 255, 255, 0.92);
      border: 1px solid #d9e1f0;
      border-radius: 14px;
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 0 16px;
      position: relative;
      overflow: hidden;
      transition: 0.22s ease;
      box-shadow: 0 8px 18px rgba(69, 83, 121, 0.06);
    }

    .agent-card::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(88, 114, 255, 0.08), transparent 56%);
      opacity: 0;
      transition: 0.22s ease;
    }

    .agent-card:hover {
      transform: translateY(-2px);
      border-color: #c7d4f3;
      box-shadow: 0 14px 28px rgba(79, 110, 247, 0.12);
    }

    .agent-card:hover::after {
      opacity: 1;
    }

    .agent-card.highlighted {
      border-color: #6e88ff;
      box-shadow: 0 0 0 2px rgba(111, 135, 255, 0.18), 0 18px 30px rgba(86, 112, 235, 0.16);
      transform: translateY(-2px) scale(1.02);
      animation: cardFlash 0.7s ease;
    }

    @keyframes cardFlash {
      0% { transform: scale(1); }
      40% { transform: scale(1.035); }
      100% { transform: scale(1.02); }
    }

    .agent-card img {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      object-fit: cover;
      background: #eef2fa;
      flex-shrink: 0;
    }

    .agent-meta {
      min-width: 0;
      position: relative;
      z-index: 1;
    }

    .agent-meta strong {
      display: block;
      font-size: 14px;
      color: #2c3650;
      font-weight: 800;
    }

    .agent-meta span {
      display: block;
      font-size: 11px;
      color: #93a0b4;
      margin-top: 4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 126px;
    }

    .composer-stage {
      width: min(900px, 100%);
      margin-top: 22px;
      position: relative;
      padding-top: 40px;
    }

    .listen-overlay {
      position: absolute;
      left: 0;
      right: 0;
      top: 0;
      display: flex;
      justify-content: center;
      pointer-events: none;
      opacity: 0;
      transform: translateY(8px);
      transition: 0.24s ease;
      z-index: 9;
    }

    .listen-overlay.active {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .listen-panel {
      width: min(760px, calc(100% - 60px));
      min-height: 54px;
      border-radius: 18px;
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 18px 38px rgba(78, 100, 148, 0.16);
      border: 1px solid rgba(215, 223, 240, 0.96);
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 12px 18px;
    }

    .listen-signal {
      display: flex;
      align-items: center;
      gap: 4px;
      flex-shrink: 0;
    }

    .listen-dot {
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: #ff5e67;
      box-shadow: 0 0 0 8px rgba(255, 94, 103, 0.12);
      animation: dotPulse 1.2s infinite ease-in-out;
    }

    @keyframes dotPulse {
      0%, 100% { transform: scale(1); opacity: 1; }
      50% { transform: scale(1.2); opacity: 0.78; }
    }

    .wave-bars {
      display: flex;
      align-items: flex-end;
      gap: 3px;
      height: 18px;
    }

    .wave-bars i {
      display: block;
      width: 4px;
      height: var(--wave-height, 12px);
      border-radius: 999px;
      background: linear-gradient(180deg, #ff6c72 0%, #ff5e67 100%);
      animation: waveDance 1s infinite ease-in-out;
      transform-origin: center bottom;
    }

    .wave-bars i:nth-child(1) { --wave-height: 8px; animation-delay: 0.1s; }
    .wave-bars i:nth-child(2) { --wave-height: 16px; animation-delay: 0.2s; }
    .wave-bars i:nth-child(3) { --wave-height: 12px; animation-delay: 0.3s; }
    .wave-bars i:nth-child(4) { --wave-height: 18px; animation-delay: 0.15s; }
    .wave-bars i:nth-child(5) { --wave-height: 9px; animation-delay: 0.25s; }

    @keyframes waveDance {
      0%, 100% { transform: scaleY(0.55); opacity: 0.8; }
      50% { transform: scaleY(1.08); opacity: 1; }
    }

    .listen-copy {
      flex: 1;
      min-width: 0;
    }

    .listen-copy strong {
      display: block;
      font-size: 13px;
      color: #3c4862;
      margin-bottom: 4px;
    }

    .listen-copy span {
      display: block;
      font-size: 14px;
      color: #7b889f;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .listen-cancel {
      pointer-events: auto;
      height: 30px;
      padding: 0 14px;
      border-radius: 999px;
      background: #f4f6fb;
      color: #6b7690;
      font-size: 12px;
      font-weight: 700;
    }

    .mini-toolbar {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
      padding-left: 4px;
    }

    .model-chip,
    .prompt-chip {
      height: 24px;
      border-radius: 999px;
      border: 1px solid #d6dff2;
      background: rgba(255, 255, 255, 0.95);
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 0 10px;
      font-size: 12px;
      color: #8b79ff;
      box-shadow: 0 4px 12px rgba(66, 87, 133, 0.06);
    }

    .prompt-chip {
      color: #67738a;
    }

    .composer {
      border-radius: 22px;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid #dce2ef;
      box-shadow: 0 18px 44px rgba(85, 102, 145, 0.11);
      overflow: hidden;
      position: relative;
    }

    .composer textarea {
      width: 100%;
      min-height: 110px;
      max-height: 180px;
      resize: none;
      padding: 18px 18px 12px;
      border: 0;
      outline: none;
      background: transparent;
      color: #3f495d;
      font-size: 15px;
      line-height: 1.65;
    }

    .composer textarea::placeholder {
      color: #c0c8d7;
    }

    .composer-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 12px 16px 14px;
      border-top: 1px solid rgba(232, 236, 245, 0.88);
    }

    .tool-row,
    .action-row {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .icon-tool,
    .tool-pill,
    .assistant-select,
    .mic-trigger,
    .direct-voice-trigger,
    .send-trigger {
      height: 32px;
      border-radius: 10px;
      border: 1px solid #d6dcec;
      background: #fff;
      color: #606a7e;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 12px;
      font-size: 13px;
      transition: 0.2s ease;
      flex-shrink: 0;
    }

    .icon-tool {
      width: 32px;
      padding: 0;
    }

    .tool-pill.active {
      color: #4f6ef7;
      background: #edf2ff;
      border-color: #c7d4ff;
      box-shadow: inset 0 0 0 1px rgba(79, 110, 247, 0.08);
    }

    .tool-pill.pulse {
      animation: toolPulse 0.44s cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    @keyframes toolPulse {
      0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(79, 110, 247, 0.18); }
      55% { transform: scale(1.08); box-shadow: 0 0 0 10px rgba(79, 110, 247, 0.08); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(79, 110, 247, 0); }
    }

    .tool-pill:hover,
    .icon-tool:hover,
    .assistant-select:hover,
    .mic-trigger:hover,
    .direct-voice-trigger:hover,
    .send-trigger:hover {
      background: #f6f8fd;
    }

    .assistant-select {
      padding-right: 8px;
      color: #5f6c84;
      white-space: nowrap;
      max-width: 140px;
    }

    .mic-trigger {
      width: 32px;
      padding: 0;
      position: relative;
      overflow: visible;
    }

    .mic-trigger.listening {
      color: #fff;
      background: linear-gradient(135deg, #ff666d 0%, #ff4f59 100%);
      border-color: rgba(255, 95, 99, 0.6);
      box-shadow: 0 0 0 10px rgba(255, 95, 99, 0.13);
      animation: micBreath 1.1s infinite ease-in-out;
    }

    @keyframes micBreath {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.06); }
    }

    .mic-trigger.listening::after {
      content: "";
      position: absolute;
      inset: -4px;
      border-radius: 14px;
      border: 1px solid rgba(255, 95, 99, 0.38);
      animation: micRing 1.2s infinite ease-out;
    }

    @keyframes micRing {
      0% { transform: scale(1); opacity: 0.75; }
      100% { transform: scale(1.55); opacity: 0; }
    }

    .send-trigger {
      width: 32px;
      padding: 0;
    }

    .direct-voice-trigger {
      padding: 0 12px;
      color: #54657f;
      position: relative;
    }

    .direct-voice-trigger.active {
      border-color: #b8cffb;
      background: linear-gradient(135deg, #edf3ff 0%, #f5fbff 100%);
      color: #4867f5;
      box-shadow: inset 0 0 0 1px rgba(79, 110, 247, 0.08);
    }

    .direct-voice-trigger.listening::after {
      content: "";
      position: absolute;
      inset: -4px;
      border-radius: 12px;
      border: 1px solid rgba(79, 110, 247, 0.22);
      animation: micRing 1.3s infinite ease-out;
    }

    .warning-text {
      width: min(900px, 100%);
      text-align: center;
      font-size: 12px;
      color: #ff4d54;
      margin-top: 8px;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .toast-stack {
      position: fixed;
      top: 72px;
      right: 24px;
      z-index: 60;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast {
      min-width: 260px;
      max-width: 360px;
      padding: 13px 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.98);
      border: 1px solid rgba(220, 226, 240, 0.98);
      box-shadow: 0 18px 34px rgba(81, 95, 133, 0.16);
      display: flex;
      align-items: flex-start;
      gap: 10px;
      color: #344056;
      animation: toastIn 0.28s cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    .toast.fade-out {
      animation: toastOut 0.25s ease forwards;
    }

    .toast strong {
      font-size: 14px;
    }

    .toast span {
      display: block;
      font-size: 12px;
      line-height: 1.55;
      margin-top: 2px;
      color: #67738a;
    }

