    function detectMetricRouteV2(text) {
      const value = normalizeV2(text);
      const metric = METRIC_CATALOG_V2.find((item) => includesAnyV2(value, item.synonyms));
      if (!metric) return null;
      return {
        id: `metric-${metric.id}`,
        phrases: metric.synonyms,
        action: "open_metric_page",
        target: { metricId: metric.id, agentId: metric.ownerAgentId },
        defaultEntities: { period: metric.defaultPeriod },
        followups: METRIC_DATA_V2[metric.mockDataKey]?.suggestions || []
      };
    }

    function routeScoreV2(route, value) {
      let score = 0;
      (route.phrases || route.exact || []).forEach((phrase) => {
        const normalized = normalizeV2(phrase);
        if (normalized && value.includes(normalized)) score = Math.max(score, 100 + normalized.length);
      });
      // 关键词模糊兜底：语音识别错字时仍能命中正确路由
      const kws = route.keywords || [];
      if (kws.length > 0 && score === 0) {
        const hits = kws.filter((kw) => value.includes(kw)).length;
        if (hits / kws.length >= 0.6) score = Math.max(score, 50 + hits * 5);
      }
      return score;
    }

    function resolveRouteV2(text) {
      const value = normalizeV2(text);
      let best = null;
      let bestScore = 0;
      SCENARIO_ROUTE_TABLE.forEach((route) => {
        const score = routeScoreV2(route, value);
        if (score > bestScore) {
          best = route;
          bestScore = score;
        }
      });
      if (best) return best;
      return detectMetricRouteV2(value);
    }

    function buildPlanV2(route, text, source = "manual") {
      if (!route) return null;
      if (route.action === "wake") return { route, action: "wake", text, source };

      const scenario = getScenarioConfigV2(route.id);
      const target = route.target || {};
      const agent = getAgentV2(target.agentId || route.agentId);
      if (!agent) return null;
      const metric = target.metricId ? getMetricV2(target.metricId) : null;
      const answerPayload = route.answerKey ? (ANSWER_LIBRARY_V2[route.answerKey] || buildPolicyAnswerV2(text)) : null;

      let entities = { ...(route.defaultEntities || {}) };
      if (agent.taskType === "meeting") entities = { ...entities, ...extractMeetingV2(text) };
      if (agent.taskType === "analysis") entities = { ...entities, ...extractAnalysisV2(text) };
      if (agent.taskType === "archive") entities = { ...entities, ...extractArchiveV2(text) };
      if (agent.taskType === "contract") entities = { ...entities, ...extractContractV2(text) };
      if (metric) entities = { ...entities, ...extractMetricV2(text, metric) };

