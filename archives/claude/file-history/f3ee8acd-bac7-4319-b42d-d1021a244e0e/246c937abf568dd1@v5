    function renderVoiceMeterV2(level = 0, mode = "idle") {
      const safeLevel = Math.max(0, Math.min(1, Number(level) || 0));
      const multipliers = mode === "direct"
        ? [0.54, 0.98, 0.8, 1.08, 0.62]
        : [0.42, 0.88, 0.72, 0.96, 0.5];
      elsV2.listenWaveBars.forEach((bar, index) => {
        const next = 8 + Math.round((6 + safeLevel * 24) * multipliers[index]);
        bar.style.height = `${next}px`;
        bar.style.opacity = `${0.5 + safeLevel * 0.5}`;
      });
    }

    function updateVoicePresenceV2(mode, phase, transcript = "") {
      const text = String(transcript || "").trim();
      const hasText = Boolean(text);
      stateV2.voiceUiLockedUntil = Date.now() + 900;

      if (phase === "thinking") {
        setPetStatusV2(hasText ? `正在理解：${text}` : "我在理解你的需求，马上给你动作和结果");
        showListenOverlayV2("正在理解...", hasText ? text : "正在把语音理解成动作和任务。");
        return;
      }
      if (phase === "speaking") {
        setPetStatusV2(hasText ? `正在回应：${text}` : "我在边说边做，会同步动作、口型和页面调度");
        showListenOverlayV2("正在回应...", hasText ? text : "我会一边回应，一边把目标页面和步骤拉起来。");
        return;
      }
      if (phase === "listening") {
        setPetStatusV2(hasText ? `我听到：${text}` : "我在听，你可以继续说");
        showListenOverlayV2("正在聆听...", hasText ? text : "继续说，我会根据内容做出反应。");
        return;
      }
      setPetStatusV2(hasText ? `正在听：${text}` : "我在听，你可以继续说");
    }

    function stopVoiceMeterV2() {
      stateV2.voiceUiLockedUntil = 0;
      if (stateV2.voiceMeterRaf) {
        window.cancelAnimationFrame(stateV2.voiceMeterRaf);
        stateV2.voiceMeterRaf = 0;
      }
      if (stateV2.voiceSource) {
        try { stateV2.voiceSource.disconnect(); } catch (error) {}
        stateV2.voiceSource = null;
      }
      if (stateV2.voiceAnalyser) {
        try { stateV2.voiceAnalyser.disconnect(); } catch (error) {}
        stateV2.voiceAnalyser = null;
      }
      if (stateV2.voiceAudioContext) {
        try { stateV2.voiceAudioContext.close(); } catch (error) {}
        stateV2.voiceAudioContext = null;
      }
      if (stateV2.voiceStream) {
        stateV2.voiceStream.getTracks().forEach((track) => track.stop());
        stateV2.voiceStream = null;
      }
      stateV2.voiceMode = "idle";
      stateV2.voiceMeterLevel = 0;
      renderVoiceMeterV2(0, "idle");
      dispatchAvatarEventV2("audioEnd");
    }

    async function startVoiceMeterV2(mode = "text") {
      stopVoiceMeterV2();
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      const AudioContextCtor = window.AudioContext || window.webkitAudioContext;
      if (!AudioContextCtor) {
        stateV2.voiceStream = stream;
        stateV2.voiceMode = mode;
        return;
      }
      const audioContext = new AudioContextCtor();
      const analyser = audioContext.createAnalyser();
      analyser.fftSize = 256;
      analyser.smoothingTimeConstant = 0.82;
      const source = audioContext.createMediaStreamSource(stream);
      source.connect(analyser);

      stateV2.voiceAudioContext = audioContext;
      stateV2.voiceAnalyser = analyser;
      stateV2.voiceSource = source;
      stateV2.voiceStream = stream;
      stateV2.voiceMode = mode;
      const buffer = new Uint8Array(analyser.fftSize);

      const tick = () => {
        if (!stateV2.voiceAnalyser) return;
        analyser.getByteTimeDomainData(buffer);
        let sum = 0;
        for (let index = 0; index < buffer.length; index += 1) {
          const value = (buffer[index] - 128) / 128;
          sum += value * value;
        }
        const rms = Math.sqrt(sum / buffer.length);
        const level = Math.max(0, Math.min(1, rms * 5.8));
        stateV2.voiceMeterLevel = level;
        renderVoiceMeterV2(level, stateV2.voiceMode);
        dispatchAvatarEventV2("audioLevel", { level });
        stateV2.voiceMeterRaf = window.requestAnimationFrame(tick);
      };

      tick();
    }

