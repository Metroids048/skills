    .pet {
      position: fixed;
      right: 28px;
      bottom: 112px;
      width: 126px;
      z-index: 45;
      user-select: none;
      touch-action: none;
      cursor: grab;
      filter: drop-shadow(0 18px 26px rgba(73, 101, 161, 0.18));
      transition: filter 0.25s ease, transform 0.25s ease;
    }

    .pet.dragging {
      cursor: grabbing;
      filter: drop-shadow(0 26px 34px rgba(64, 88, 144, 0.26));
    }

    .pet.hover {
      filter: drop-shadow(0 24px 36px rgba(79, 110, 247, 0.2));
    }

    .pet.standby {
      filter: drop-shadow(0 24px 36px rgba(55, 189, 200, 0.18));
    }

    .pet-core {
      position: relative;
      width: 126px;
      height: 176px;
      transform-origin: center bottom;
      animation: petIdle 3.4s ease-in-out infinite;
      transition: transform 0.22s ease, filter 0.22s ease;
    }

    @keyframes petIdle {
      0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
      50% { transform: translateY(-5px) rotate(-0.6deg) scale(1.01); }
    }

    .pet.hover .pet-core {
      transform: translateY(-6px) rotate(-3deg) scale(1.08);
    }

    .pet.awake .pet-core {
      animation: petAwake 0.72s ease-in-out infinite alternate;
    }

    @keyframes petAwake {
      from { transform: translateY(-2px) rotate(-4deg) scale(1.08); }
      to { transform: translateY(-6px) rotate(4deg) scale(1.11); }
    }

    .pet.thinking .pet-core {
      animation: petThinking 1.2s ease-in-out infinite;
    }

    @keyframes petThinking {
      0%, 100% { transform: rotate(-2deg) scale(1.03); }
      50% { transform: rotate(2deg) scale(1.08); }
    }

    .pet.listening .pet-core {
      animation: petListening 1.05s ease-in-out infinite;
    }

    .pet.confirming .pet-core {
      animation: petThinking 1.15s ease-in-out infinite;
    }

    .pet.speaking .pet-core {
      animation: petSpeaking 0.65s ease-in-out infinite;
    }

    .pet.executing .pet-core {
      animation: none;
      transform: translateY(-6px) rotate(var(--point-angle, 0deg)) scale(1.08);
    }

    .pet.success .pet-core {
      animation: petSuccess 0.7s cubic-bezier(0.34, 1.3, 0.64, 1);
    }

    @keyframes petSuccess {
      0% { transform: scale(1); }
      35% { transform: translateY(-12px) rotate(-6deg) scale(1.14); }
      100% { transform: scale(1); }
    }

    .thinking-dots i {
      display: inline-block;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
      margin: 0 2px;
      animation: thinking-bounce 1.2s ease-in-out infinite;
    }
    .thinking-dots i:nth-child(2) { animation-delay: 0.15s; }
    .thinking-dots i:nth-child(3) { animation-delay: 0.3s; }
    @keyframes thinking-bounce {
      0%, 60%, 100% { transform: translateY(0); opacity: 0.4; }
      30% { transform: translateY(-4px); opacity: 1; }
    }

    .pet.dragging .pet-core {
      animation: none;
      transform: scale(1.05) rotate(var(--drag-tilt, 0deg));
    }

    @keyframes petListening {
      0%, 100% { transform: translateY(-2px) rotate(-2deg) scale(1.04); }
      50% { transform: translateY(-8px) rotate(2deg) scale(1.09); }
    }

    @keyframes petSpeaking {
      0%, 100% { transform: translateY(-4px) scale(1.03); }
      50% { transform: translateY(-9px) scale(1.08); }
    }

    .pet-rings,
    .pet-rings::before,
    .pet-rings::after {
      position: absolute;
      inset: -14px -10px -10px -10px;
      border-radius: 999px;
      border: 1px solid rgba(98, 118, 255, 0.14);
      content: "";
      pointer-events: none;
    }

    .pet-rings {
      animation: ringSpin 9s linear infinite;
    }

    .pet-rings::before {
      inset: -20px -15px -16px -15px;
      border-color: rgba(55, 189, 200, 0.12);
      animation: ringSpinReverse 11s linear infinite;
    }

    .pet-rings::after {
      inset: -28px -18px -20px -18px;
      border-color: rgba(127, 150, 255, 0.1);
      animation: ringSpin 15s linear infinite;
    }

    @keyframes ringSpin {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    @keyframes ringSpinReverse {
      from { transform: rotate(360deg); }
      to { transform: rotate(0deg); }
    }

    .pet.executing .pet-rings,
    .pet.listening .pet-rings,
    .pet.speaking .pet-rings,
    .pet.awake .pet-rings,
    .pet.thinking .pet-rings,
    .pet.confirming .pet-rings,
    .pet.standby .pet-rings {
      border-color: rgba(79, 110, 247, 0.3);
      box-shadow: 0 0 0 12px rgba(79, 110, 247, 0.06);
    }

    .pet.listening .pet-rings::before,
    .pet.speaking .pet-rings::before {
      border-color: rgba(255, 95, 99, 0.22);
    }

    .pet-glow {
      position: absolute;
      left: 50%;
      bottom: 6px;
