    .pet.listening .pet-core {
      animation: petListeningEnhanced 0.9s ease-in-out infinite;
    }

    .pet.speaking .pet-core {
      animation: petSpeakingEnhanced 0.58s ease-in-out infinite;
    }

    .pet.executing .pet-core {
      animation: none;
      transform: translateY(-7px) rotate(var(--point-angle, 0deg)) scale(1.11);
    }

    .pet.success .pet-core {
      animation: petSuccessEnhanced 0.82s cubic-bezier(0.34, 1.3, 0.64, 1);
