    function extractMeetingV2(text) {
      const compact = normalizeV2(text).replace(/\s+/g, "");
      const date = compact.includes("后天") ? "后天" : compact.includes("今天") ? "今天" : "明天";
      let period = compact.includes("上午") || compact.includes("早上") ? "上午" : "下午";
      let time = "3点";
      const hmMatch = compact.match(/(\d{1,2})[:：](\d{1,2})/);
      const pointMatch = compact.match(/(\d{1,2})点/);
      if (hmMatch) {
        time = `${hmMatch[1]}:${hmMatch[2]}`;
        period = Number(hmMatch[1]) >= 12 ? "下午" : "上午";
      } else if (pointMatch) {
        time = `${pointMatch[1]}点`;
        period = Number(pointMatch[1]) >= 12 ? "下午" : period;
      }
      return {
        date,
        period,
        time,
        topic: compact.includes("周会") ? "海小南周会" : "待补充主题"
      };
    }

